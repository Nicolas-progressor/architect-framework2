# Пример конфигурационного файла окружения
# Скопируйте этот файл в .env и настройте под ваше окружение

# Текущее окружение: development, testing, staging, production
APP_ENV=development

# Настройки базы данных
DB_HOST=localhost
DB_PORT=3306
DB_NAME=arcred_dev
DB_USER=root
DB_PASSWORD=

# Настройки кэширования (redis, memcached, file)
CACHE_DRIVER=file

# Секретный ключ приложения
APP_KEY=your-secret-key-here

# URL приложения
APP_URL=http://localhost
