#!/usr/bin/env php
<?php

declare(strict_types=1);

/**
 * Architect Console Entry Point (Composer bin)
 *
 * This file is automatically generated by Composer and provides
 * the 'arc' command globally after package installation.
 *
 * Usage:
 *   arc <command> [arguments] [options]
 */

$baseDir = dirname(__DIR__);

define('ROOT_DIR', $baseDir . '/');
define('APP_DIR', ROOT_DIR . 'app/');
define('ARC_DIR', ROOT_DIR . 'architect/');
define('ARC_LANG', 'ru');

// Set environment
putenv('APP_ENV=development');

// Load Composer autoloader
require_once ROOT_DIR . 'vendor/autoload.php';

// Bootstrap console application (loads container and providers)
$container = require ROOT_DIR . 'bootstrap/console.php';

// Get console kernel from container
$console = $container->get('console');

// Run console
$exitCode = $console->run();

exit($exitCode);
