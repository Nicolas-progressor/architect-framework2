{
    "name": "architect/blueprint",
    "description": "Blueprint template engine - a Blade/Twig-like templating system for PHP",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "template",
        "templating",
        "blade",
        "twig",
        "engine",
        "architect",
        "framework"
    ],
    "homepage": "https://github.com/architect/blueprint",
    "autoload": {
        "psr-4": {
            "Blueprint\\Engine\\": "src/",
            "Blueprint\\Engine\\Integrations\\Architect\\": "src/Integrations/Architect/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Blueprint\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10"
    },
    "suggest": {
        "architect/framework": "Architect Framework - for full integration"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}