{
    "name": "architect/contracts",
    "description": "Core contracts and interfaces for Architect Framework",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "contracts",
        "interfaces",
        "architect",
        "framework"
    ],
    "homepage": "https://github.com/architect/contracts",
    "authors": [{
        "name": "Architect Team",
        "email": "team@architect.dev"
    }],
    "require": {
        "php": ">=8.1",
        "psr/container": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "Architect\\Contracts\\": "src/Architect/Contracts/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Architect\\Contracts\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
