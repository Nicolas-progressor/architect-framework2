<!DOCTYPE html>
<html lang="ru" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title|default('Blueprint — Документация') }}</title>
    <meta name="description" content="Документация по шаблонизатору Blueprint для PHP">
    
    {# Tailwind CSS CDN #}
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        'bp-dark': {
                            50: '#f7f7f8',
                            100: '#ececf1',
                            200: '#d9d9e3',
                            300: '#c5c5d2',
                            400: '#acacbe',
                            500: '#8e8ea0',
                            600: '#565869',
                            700: '#40414f',
                            800: '#343541',
                            900: '#202123',
                            950: '#0d0d0f'
                        },
                        'bp-accent': {
                            400: '#a78bfa',
                            500: '#8b5cf6',
                            600: '#7c3aed'
                        },
                        'bp-green': {
                            400: '#4ade80',
                            500: '#22c55e'
                        },
                        'bp-blue': {
                            400: '#60a5fa',
                            500: '#3b82f6'
                        },
                        'bp-orange': {
                            400: '#fb923c',
                            500: '#f97316'
                        }
                    },
                    fontFamily: {
                        'sans': ['Inter', 'system-ui', 'sans-serif'],
                        'mono': ['JetBrains Mono', 'Fira Code', 'monospace']
                    }
                }
            }
        }
    </script>
    
    {# Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    
    <style>
        {# Custom scrollbar #}
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #343541;
        }
        ::-webkit-scrollbar-thumb {
            background: #565869;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #8e8ea0;
        }
        
        {# Code highlighting #}
        pre code {
            font-family: 'JetBrains Mono', monospace;
        }
        
        {# Smooth transitions #}
        * {
            transition-property: background-color, border-color, color;
            transition-duration: 150ms;
        }
        
        {# Sidebar active link #}
        .sidebar-link.active {
            background: linear-gradient(90deg, rgba(139, 92, 246, 0.15) 0%, transparent 100%);
            border-left-color: #8b5cf6;
            color: #a78bfa;
        }
        
        {# Code block styling #}
        .code-block {
            background: #202123;
            border: 1px solid #343541;
            border-radius: 0.5rem;
        }
        
        {# Inline code #}
        code:not(pre code) {
            background: #343541;
            padding: 0.125rem 0.375rem;
            border-radius: 0.25rem;
            font-size: 0.875em;
        }
    </style>
    
    {% block head %}{% endblock %}
</head>
<body class="bg-bp-dark-900 text-bp-dark-100 min-h-screen font-sans antialiased">
    
    {!! element('navbar') !!}
    
    <div class="flex">
        {# Sidebar #}
        <aside class="hidden lg:block w-64 min-h-screen bg-bp-dark-800 border-r border-bp-dark-700 sticky top-16 h-[calc(100vh-4rem)] overflow-y-auto">
            {!! element('sidebar') !!}
        </aside>
        
        {# Main content #}
        <main class="flex-1 min-h-screen">
            <div class="max-w-4xl mx-auto px-6 py-8">
                {{ content|raw }}
            </div>
        </main>
    </div>
    
    {!! element('footer') !!}
    
    {% block scripts %}{% endblock %}
    

</body>
</html>
