<nav class="py-6 px-4">
    {% for section in sections %}
    <div class="mb-6">
        <h3 class="px-3 mb-2 text-xs font-semibold text-bp-dark-500 uppercase tracking-wider">
            {{ section.title }}
        </h3>
        <ul class="space-y-1">
            {% for item in section.items %}
            <li>
                <a href="{{ item.url }}" class="sidebar-link flex items-center px-3 py-2 text-sm rounded-lg border-l-2 border-transparent text-bp-dark-400 hover:text-bp-dark-200 hover:bg-bp-dark-700/50 transition-colors">
                    <span class="w-4 h-4 mr-3 flex items-center justify-center">
                        {% if item.icon == 'home' %}⌂
                        {% elseif item.icon == 'download' %}↓
                        {% elseif item.icon == 'code' %}⟨⟩
                        {% elseif item.icon == 'variable' %}𝑥
                        {% elseif item.icon == 'filter' %}⋔
                        {% elseif item.icon == 'function' %}ƒ
                        {% elseif item.icon == 'branch' %}⑂
                        {% elseif item.icon == 'layers' %}☰
                        {% elseif item.icon == 'puzzle' %}🧩
                        {% elseif item.icon == 'plugin' %}⚙
                        {% elseif item.icon == 'book' %}📖
                        {% elseif item.icon == 'link' %}🔗
                        {% endif %}
                    </span>
                    {{ item.name }}
                </a>
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endfor %}
</nav>
