{# Integrations Page #}
<div class="mb-8">
    <h1 class="text-3xl font-bold text-bp-dark-100 mb-4">Интеграции</h1>
    <p class="text-bp-dark-400">Использование Blueprint с различными фреймворками</p>
</div>

<div class="space-y-8">
    <section>
        <h2 class="text-xl font-semibold text-bp-dark-100 mb-4">Architect Framework</h2>
        <p class="text-bp-dark-300 mb-4">Blueprint интегрирован в Architect по умолчанию.</p>
        <div class="code-block p-4">
            {% raw %}<pre class="text-sm text-bp-dark-200">{# В контроллере #}
$this-&gt;render('template', ['data' =&gt; $value]);

{# В шаблоне #}
{{ data }}
{!! element('navbar') !!}</pre>{% endraw %}
        </div>
    </section>

    <section>
        <h2 class="text-xl font-semibold text-bp-dark-100 mb-4">Laravel</h2>
        <div class="code-block p-4">
            {% raw %}<pre class="text-sm text-bp-dark-200">// config/view.php
'paths' =&gt; [
    resource_path('views'),
],

// В контроллере
return view('page', ['title' =&gt; 'Заголовок']);

// Шаблон: resources/views/page.blu
{{ title }}</pre>{% endraw %}
        </div>
    </section>

    <section>
        <h2 class="text-xl font-semibold text-bp-dark-100 mb-4">Автономное использование</h2>
        <div class="code-block p-4">
            {% raw %}<pre class="text-sm text-bp-dark-200">&lt;?php

require 'vendor/autoload.php';

use Blueprint\Engine\Blueprint;

$blueprint = new Blueprint([
    'paths' =&gt; [__DIR__ . '/templates'],
    'cache' =&gt; __DIR__ . '/cache',
    'cache_enabled' =&gt; true,
]);

// Рендер в строку
$html = $blueprint-&gt;render('page', [
    'title' =&gt; 'Заголовок',
    'items' =&gt; ['one', 'two', 'three'],
]);

// Вывод
$blueprint-&gt;display('page', ['title' =&gt; 'Заголовок']);</pre>{% endraw %}
        </div>
    </section>

    <section>
        <h2 class="text-xl font-semibold text-bp-dark-100 mb-4">Советы</h2>
        <div class="space-y-3">
            <div class="bg-bp-dark-800 border-l-4 border-bp-green-500 rounded-lg p-4">
                <p class="text-sm text-bp-dark-300">
                    <span class="text-bp-green-400 font-medium">Производительность:</span>
                    Всегда включайте кеш в production для максимальной скорости.
                </p>
            </div>
            <div class="bg-bp-dark-800 border-l-4 border-bp-blue-500 rounded-lg p-4">
                <p class="text-sm text-bp-dark-300">
                    <span class="text-bp-blue-400 font-medium">Безопасность:</span>
                    Используйте <code class="text-bp-accent-400">\{\% raw \%\}\{\{ \}\}\{\% endraw \%\}</code> для пользовательских данных, <code class="text-bp-accent-400">{!! !!}</code> только для доверенного HTML.
                </p>
            </div>
            <div class="bg-bp-dark-800 border-l-4 border-bp-accent-500 rounded-lg p-4">
                <p class="text-sm text-bp-dark-300">
                    <span class="text-bp-accent-400 font-medium">Отладка:</span>
                    В development режиме включайте debug для детальных сообщений об ошибках.
                </p>
            </div>
        </div>
    </section>
</div>

{# Navigation #}
<div class="flex items-center justify-between pt-8 mt-8 border-t border-bp-dark-700">
    <a href="/api" class="flex items-center space-x-2 text-bp-dark-400 hover:text-bp-dark-200 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        <span>API</span>
    </a>
    <a href="/" class="flex items-center space-x-2 px-4 py-2 bg-bp-accent-500 hover:bg-bp-accent-600 text-white rounded-lg transition-colors">
        <span>На главную</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
        </svg>
    </a>
</div>
