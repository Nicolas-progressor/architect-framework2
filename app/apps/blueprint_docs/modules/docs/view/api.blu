{# API Page #}
<div class="mb-8">
    <h1 class="text-3xl font-bold text-bp-dark-100 mb-4">API Reference</h1>
    <p class="text-bp-dark-400">Полный справочник по API Blueprint</p>
</div>

<div class="space-y-8">
    <section>
        <h2 class="text-xl font-semibold text-bp-dark-100 mb-4">Класс Blueprint</h2>
        <div class="code-block p-4">
            {% raw %}<pre class="text-sm text-bp-dark-200">$blueprint = new Blueprint(array $config = []);

// Методы
$blueprint-&gt;render(string $template, array $data = []): string;
$blueprint-&gt;display(string $template, array $data = []): void;
$blueprint-&gt;addGlobal(string $name, mixed $value): void;
$blueprint-&gt;addExtension(ExtensionInterface $extension): void;
$blueprint-&gt;addFilter(string $name, callable $callback): void;
$blueprint-&gt;addFunction(string $name, callable $callback): void;
$blueprint-&gt;setCache(string $path, bool $enabled = true): void;
$blueprint-&gt;clearCache(): void;</pre>{% endraw %}
        </div>
    </section>

    <section>
        <h2 class="text-xl font-semibold text-bp-dark-100 mb-4">Конфигурация</h2>
        <div class="code-block p-4">
            {% raw %}<pre class="text-sm text-bp-dark-200">$config = [
    'paths' =&gt; ['./templates'],           // Пути к шаблонам
    'cache' =&gt; './cache/blueprints',      // Путь к кешу
    'cache_enabled' =&gt; true,              // Включить кеш
    'debug' =&gt; false,                     // Режим отладки
    'autoescape' =&gt; true,                 // Автоэкранирование
    'extensions' =&gt; ['.blu'],             // Расширения файлов
    'globals' =&gt; [],                      // Глобальные переменные
];</pre>{% endraw %}
        </div>
    </section>

    <section>
        <h2 class="text-xl font-semibold text-bp-dark-100 mb-4">Теги</h2>
        <div class="bg-bp-dark-800 border border-bp-dark-700 rounded-lg overflow-hidden">
            <table class="w-full text-sm">
                <thead class="bg-bp-dark-700">
                    <tr>
                        <th class="px-4 py-2 text-left text-bp-dark-300">Тег</th>
                        <th class="px-4 py-2 text-left text-bp-dark-300">Описание</th>
                    </tr>
                </thead>
                <tbody class="text-bp-dark-300">
                    <tr class="border-b border-bp-dark-700">
                        <td class="px-4 py-2 font-mono text-bp-accent-400">{% raw %}{{ }}{% endraw %}</td>
                        <td class="px-4 py-2">Вывод с экранированием</td>
                    </tr>
                    <tr class="border-b border-bp-dark-700">
                        <td class="px-4 py-2 font-mono text-bp-accent-400">{% raw %}{!! !!}{% endraw %}</td>
                        <td class="px-4 py-2">Вывод без экранирования</td>
                    </tr>
                    <tr class="border-b border-bp-dark-700">
                        <td class="px-4 py-2 font-mono text-bp-accent-400">{% raw %}{# #}{% endraw %}</td>
                        <td class="px-4 py-2">Комментарий</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2 font-mono text-bp-accent-400">{% raw %}{% %}{% endraw %}</td>
                        <td class="px-4 py-2">Управляющая конструкция</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section>
        <h2 class="text-xl font-semibold text-bp-dark-100 mb-4">Операторы</h2>
        <div class="bg-bp-dark-800 border border-bp-dark-700 rounded-lg overflow-hidden">
            <table class="w-full text-sm">
                <thead class="bg-bp-dark-700">
                    <tr>
                        <th class="px-4 py-2 text-left text-bp-dark-300">Оператор</th>
                        <th class="px-4 py-2 text-left text-bp-dark-300">Описание</th>
                    </tr>
                </thead>
                <tbody class="text-bp-dark-300">
                    <tr class="border-b border-bp-dark-700">
                        <td class="px-4 py-2 font-mono text-bp-accent-400">in</td>
                        <td class="px-4 py-2">Проверка вхождения</td>
                    </tr>
                    <tr class="border-b border-bp-dark-700">
                        <td class="px-4 py-2 font-mono text-bp-accent-400">not in</td>
                        <td class="px-4 py-2">Проверка отсутствия</td>
                    </tr>
                    <tr class="border-b border-bp-dark-700">
                        <td class="px-4 py-2 font-mono text-bp-accent-400">is</td>
                        <td class="px-4 py-2">Проверка (is defined, is empty)</td>
                    </tr>
                    <tr class="border-b border-bp-dark-700">
                        <td class="px-4 py-2 font-mono text-bp-accent-400">..</td>
                        <td class="px-4 py-2">Диапазон (1..10)</td>
                    </tr>
                    <tr class="border-b border-bp-dark-700">
                        <td class="px-4 py-2 font-mono text-bp-accent-400">|</td>
                        <td class="px-4 py-2">Применение фильтра</td>
                    </tr>
                    <tr>
                        <td class="px-4 py-2 font-mono text-bp-accent-400">~</td>
                        <td class="px-4 py-2">Конкатенация строк</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>
</div>

{# Navigation #}
<div class="flex items-center justify-between pt-8 mt-8 border-t border-bp-dark-700">
    <a href="/extending" class="flex items-center space-x-2 text-bp-dark-400 hover:text-bp-dark-200 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        <span>Расширение</span>
    </a>
    <a href="/integrations" class="flex items-center space-x-2 px-4 py-2 bg-bp-accent-500 hover:bg-bp-accent-600 text-white rounded-lg transition-colors">
        <span>Интеграции</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
    </a>
</div>
