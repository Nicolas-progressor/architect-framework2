<nav class="bg-bp-dark-800 border-b border-bp-dark-700 sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
            {# Logo #}
            <div class="flex items-center space-x-3">
                <a href="/" class="flex items-center space-x-2 group">
                    <div class="w-8 h-8 bg-gradient-to-br from-bp-accent-500 to-bp-blue-500 rounded-lg flex items-center justify-center">
                        <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
                        </svg>
                    </div>
                    <span class="text-lg font-semibold text-bp-dark-100 group-hover:text-bp-accent-400 transition-colors">
                        Blueprint
                    </span>
                </a>
                <span class="text-xs text-bp-dark-500 hidden sm:inline">v1.0</span>
            </div>
            
            {# Desktop menu #}
            <div class="hidden md:flex items-center space-x-1">
                {% for item in menu %}
                <a href="{{ item.url }}" 
                   class="px-4 py-2 text-sm text-bp-dark-300 hover:text-bp-dark-100 hover:bg-bp-dark-700 rounded-lg transition-colors flex items-center space-x-2"
                   {% if item.external %}target="_blank" rel="noopener noreferrer"{% endif %}>
                    {% if item.icon == 'book' %}
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                    {% elseif item.icon == 'github' %}
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                    </svg>
                    {% endif %}
                    <span>{{ item.name }}</span>
                    {% if item.external %}
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                    </svg>
                    {% endif %}
                </a>
                {% endfor %}
            </div>
            
            {# Mobile menu button #}
            <button type="button" class="md:hidden p-2 text-bp-dark-400 hover:text-bp-dark-100 hover:bg-bp-dark-700 rounded-lg" onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                </svg>
            </button>
        </div>
    </div>
    
    {# Mobile menu #}
    <div id="mobile-menu" class="hidden md:hidden border-t border-bp-dark-700">
        <div class="px-4 py-3 space-y-2">
            {% for item in menu %}
            <a href="{{ item.url }}" 
               class="block px-4 py-2 text-sm text-bp-dark-300 hover:text-bp-dark-100 hover:bg-bp-dark-700 rounded-lg"
               {% if item.external %}target="_blank" rel="noopener noreferrer"{% endif %}>
                {{ item.name }}
            </a>
            {% endfor %}
        </div>
    </div>
</nav>
