<div class="container">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">Документация Blueprint</h2>
            <p class="lead">
                Полное руководство по синтаксису и возможностям шаблонизатора Blueprint.
            </p>
            
            <hr class="my-4">
            
            <div class="row">
                <div class="col-lg-3">
                    <div class="list-group" id="docs-nav">
                        {% for section in docs_sections %}
                        <a href="#{{ section.id }}" class="list-group-item list-group-item-action">
                            <i class="{{ section.icon }} me-2"></i>
                            {{ section.title }}
                        </a>
                        {% endfor %}
                    </div>
                </div>
                <div class="col-lg-9">
                    {% for section in docs_sections %}
                    <div id="{{ section.id }}" class="docs-section mb-5">
                        <h4 class="mb-3">
                            <i class="{{ section.icon }} text-primary me-2"></i>
                            {{ section.title }}
                        </h4>
                        <p>{{ section.description }}</p>
                        
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <div class="bg-dark text-light p-3 rounded">
                                    <small class="text-muted d-block mb-2">Синтаксис:</small>
                                    <code class="text-light">{{ section.example }}</code>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="bg-light p-3 rounded border">
                                    <small class="text-muted d-block mb-2">Результат:</small>
                                    <code>{{ section.result }}</code>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
            
            <hr class="my-4">
            
            <div class="alert alert-info">
                <i class="bi bi-info-circle-fill me-2"></i>
                <strong>Примечание:</strong> Полная документация доступна в файле <code>docs/blueprint.md</code> 
                в корне проекта.
            </div>
        </div>
    </div>
</div>
