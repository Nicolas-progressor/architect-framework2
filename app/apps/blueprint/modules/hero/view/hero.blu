<section class="hero-section mb-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold">Шаблонизатор Blueprint</h1>
                <p class="lead mb-4">Современный Blade/Twig-подобный шаблонизатор для PHP 8.1+ с поддержкой наследования, блоков, фильтров и виджетов.</p>
                <div class="d-flex gap-3">
                    <a href="features" class="btn btn-light btn-lg">
                        <i class="bi bi-stars"></i> Возможности
                    </a>
                    <a href="docs" class="btn btn-outline-light btn-lg">
                        <i class="bi bi-book"></i> Документация
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container mb-5">
    <h2 class="text-center mb-4">Возможности Blueprint</h2>
    <div class="row g-4">
        {% for feature in features %}
        <div class="col-md-6 col-lg-4">
            <div class="card feature-card shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-primary bg-opacity-10 p-3 rounded me-3">
                            <i class="bi bi-{{ feature.icon }} text-primary fs-4"></i>
                        </div>
                        <h5 class="card-title mb-0">{{ feature.title }}</h5>
                    </div>
                    <p class="card-text text-muted">{{ feature.desc }}</p>
                </div>
            </div>
        </div>
        {% endfor %}
    </div>
</section>
