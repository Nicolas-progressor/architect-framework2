<div class="container">
    <div class="row">
        <div class="col-12">
            <h2 class="mb-4">Контакты</h2>
            <p class="lead">
                Свяжитесь с нами любым удобным способом.
            </p>
            
            <hr class="my-4">
            
            <div class="row">
                <div class="col-md-6 mb-4">
                    <h4 class="mb-3">Отправить сообщение</h4>
                    
                    <form id="contact-form" method="post" action="/blueprint/contact/send">
                        <div class="mb-3">
                            <label for="name" class="form-label">Имя</label>
                            <input type="text" class="form-control" id="name" name="name" required>
                        </div>
                        
                        <div class="mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="email" required>
                        </div>
                        
                        <div class="mb-3">
                            <label for="message" class="form-label">Сообщение</label>
                            <textarea class="form-control" id="message" name="message" rows="5" required></textarea>
                        </div>
                        
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-2"></i>
                            Отправить
                        </button>
                    </form>
                    
                    <div id="form-result" class="mt-3" style="display: none;"></div>
                </div>
                
                <div class="col-md-6 mb-4">
                    <h4 class="mb-3">Контактная информация</h4>
                    
                    <div class="mb-4">
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-envelope fs-4 text-primary me-3"></i>
                            <div>
                                <strong>Email</strong>
                                <div><a href="mailto:{{ contact_info.email }}">{{ contact_info.email }}</a></div>
                            </div>
                        </div>
                        
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-telephone fs-4 text-primary me-3"></i>
                            <div>
                                <strong>Телефон</strong>
                                <div><a href="tel:{{ contact_info.phone }}">{{ contact_info.phone }}</a></div>
                            </div>
                        </div>
                        
                        <div class="d-flex align-items-center mb-3">
                            <i class="bi bi-geo-alt fs-4 text-primary me-3"></i>
                            <div>
                                <strong>Адрес</strong>
                                <div>{{ contact_info.address }}</div>
                            </div>
                        </div>
                    </div>
                    
                    <h5 class="mb-3">Мы в социальных сетях</h5>
                    <div class="d-flex gap-3">
                        {% for social in contact_info.social %}
                        <a href="{{ social.url }}" class="btn btn-outline-secondary" target="_blank" title="{{ social.name }}">
                            <i class="{{ social.icon }} fs-5"></i>
                        </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.getElementById('contact-form').addEventListener('submit', function(e) {
    e.preventDefault();
    
    const formData = new FormData(this);
    const resultDiv = document.getElementById('form-result');
    
    fetch('/blueprint/contact/send', {
        method: 'POST',
        body: formData
    })
    .then(response => response.json())
    .then(data => {
        resultDiv.style.display = 'block';
        if (data.success) {
            resultDiv.className = 'alert alert-success';
            resultDiv.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>' + data.message;
            this.reset();
        } else {
            resultDiv.className = 'alert alert-danger';
            resultDiv.innerHTML = '<i class="bi bi-exclamation-circle-fill me-2"></i>' + data.message;
        }
    })
    .catch(error => {
        resultDiv.style.display = 'block';
        resultDiv.className = 'alert alert-danger';
        resultDiv.innerHTML = '<i class="bi bi-exclamation-circle-fill me-2"></i>Произошла ошибка при отправке.';
    });
});
</script>
