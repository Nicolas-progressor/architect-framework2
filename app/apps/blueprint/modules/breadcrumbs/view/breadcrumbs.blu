<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/"><i class="bi bi-house-fill"></i></a></li>
        {% for crumb in breadcrumbs %}
        <li class="breadcrumb-item">
            <a href="{{ crumb.url }}">{{ crumb.title }}</a>
        </li>
        {% endfor %}
    </ol>
</nav>
