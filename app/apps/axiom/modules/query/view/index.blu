
{% block title %}Query Builder - Axiom ORM{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">
        <i class="fas fa-code text-blue-600 mr-2"></i>Query Builder
    </h1>
    <p class="text-gray-600 mb-8">Тестирование построителя запросов Axiom ORM</p>
    
    <div class="grid lg:grid-cols-2 gap-8">
        <!-- Форма для выполнения запросов -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <h2 class="text-xl font-bold text-gray-800 mb-4">
                <i class="fas fa-play text-green-600 mr-2"></i>Выполнить запрос
            </h2>
            
            <form id="query-form" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Тип операции</label>
                    <select name="type" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                        <option value="select">SELECT (Выборка)</option>
                        <option value="insert">INSERT (Вставка)</option>
                        <option value="update">UPDATE (Обновление)</option>
                        <option value="delete">DELETE (Удаление)</option>
                    </select>
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Имя</label>
                    <input type="text" name="name" placeholder="Имя пользователя" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                </div>
                
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                    <input type="email" name="email" placeholder="user@example.com" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
                </div>
                
                <button type="submit" class="w-full bg-blue-600 text-white py-2 px-4 rounded-lg hover:bg-blue-700 transition">
                    <i class="fas fa-paper-plane mr-2"></i>Выполнить
                </button>
            </form>
            
            <div id="query-result" class="mt-4 hidden">
                <div class="p-4 rounded-lg" id="result-content"></div>
            </div>
        </div>
        
        <!-- Статистика -->
        <div class="space-y-6">
            <div class="bg-white rounded-xl shadow-md p-6">
                <h2 class="text-xl font-bold text-gray-800 mb-4">
                    <i class="fas fa-chart-bar text-purple-600 mr-2"></i>Статистика
                </h2>
                <div class="grid grid-cols-3 gap-4" id="stats-container">
                    <div class="text-center p-4 bg-blue-50 rounded-lg">
                        <div class="text-3xl font-bold text-blue-600" id="stat-total">{{ stats.total }}</div>
                        <div class="text-sm text-gray-600">Всего</div>
                    </div>
                    <div class="text-center p-4 bg-green-50 rounded-lg">
                        <div class="text-3xl font-bold text-green-600" id="stat-active">{{ stats.active }}</div>
                        <div class="text-sm text-gray-600">Активных</div>
                    </div>
                    <div class="text-center p-4 bg-red-50 rounded-lg">
                        <div class="text-3xl font-bold text-red-600" id="stat-inactive">{{ stats.inactive }}</div>
                        <div class="text-sm text-gray-600">Неактивных</div>
                    </div>
                </div>
            </div>
            
            <div class="bg-white rounded-xl shadow-md p-6">
                <h2 class="text-xl font-bold text-gray-800 mb-4">
                    <i class="fas fa-code text-gray-600 mr-2"></i>Примеры кода
                </h2>
                <div class="space-y-3">
                    <div class="bg-gray-900 text-gray-100 p-4 rounded-lg text-sm font-mono">
                        <span class="text-purple-400">use</span> Axiom\Orm\Orm;<br><br>
                        <span class="text-yellow-400">// SELECT</span><br>
                        $users = Orm::table(<span class="text-green-400">'users'</span>)<br>
                        &nbsp;&nbsp;->where(<span class="text-green-400">'status'</span>, <span class="text-green-400">'active'</span>)<br>
                        &nbsp;&nbsp;->orderBy(<span class="text-green-400">'name'</span>)<br>
                        &nbsp;&nbsp;->limit(<span class="text-blue-400">10</span>)<br>
                        &nbsp;&nbsp;->get();
                    </div>
                    <div class="bg-gray-900 text-gray-100 p-4 rounded-lg text-sm font-mono">
                        <span class="text-yellow-400">// INSERT</span><br>
                        $id = Orm::table(<span class="text-green-400">'users'</span>)<br>
                        &nbsp;&nbsp;->insert()<br>
                        &nbsp;&nbsp;->set([<span class="text-green-400">'name'</span> => <span class="text-green-400">'John'</span>])<br>
                        &nbsp;&nbsp;->execute();
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Список пользователей -->
    <div class="mt-8 bg-white rounded-xl shadow-md p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-4">
            <i class="fas fa-users text-indigo-600 mr-2"></i>Последние пользователи
        </h2>
        
        {% if users is empty %}
        <div class="text-center py-8 text-gray-500" id="empty-message">
            <i class="fas fa-database text-4xl mb-4"></i>
            <p>Нет данных. Создайте пользователя через форму выше.</p>
        </div>
        {% else %}
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">ID</th>
                        <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Имя</th>
                        <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Email</th>
                        <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Статус</th>
                        <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Дата</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200" id="users-table-body">
                    {% for user in users %}
                    <tr class="hover:bg-gray-50">
                        <td class="px-4 py-3 text-sm">{{ user.id }}</td>
                        <td class="px-4 py-3 text-sm font-medium">{{ user.name }}</td>
                        <td class="px-4 py-3 text-sm text-blue-600">{{ user.email }}</td>
                        <td class="px-4 py-3">
                            <span class="px-2 py-1 text-xs rounded-full {% if user.status == 'active' %}bg-green-100 text-green-800{% else %}bg-red-100 text-red-800{% endif %}">
                                {{ user.status }}
                            </span>
                        </td>
                        <td class="px-4 py-3 text-sm text-gray-500">{{ user.created_at }}</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% endif %}
    </div>
</div>

<script>
// Функция обновления данных через AJAX
async function refreshData() {
    try {
        const response = await fetch('/query_data');
        const data = await response.json();
        
        // Обновляем статистику
        document.getElementById('stat-total').textContent = data.stats.total;
        document.getElementById('stat-active').textContent = data.stats.active;
        document.getElementById('stat-inactive').textContent = data.stats.inactive;
        
        // Обновляем таблицу пользователей
        const tbody = document.getElementById('users-table-body');
        const emptyMsg = document.getElementById('empty-message');
        
        if (data.users.length === 0) {
            if (tbody) tbody.remove();
            if (!emptyMsg) {
                const container = document.querySelector('.overflow-x-auto') || document.querySelector('.mt-8.bg-white:last');
                const emptyDiv = document.createElement('div');
                emptyDiv.id = 'empty-message';
                emptyDiv.className = 'text-center py-8 text-gray-500';
                emptyDiv.innerHTML = '<i class="fas fa-database text-4xl mb-4"></i><p>Нет данных. Создайте пользователя через форму выше.</p>';
                const table = document.querySelector('.mt-8.bg-white:last table');
                if (table && table.parentElement) {
                    table.parentElement.replaceWith(emptyDiv);
                }
            }
        } else {
            // Скрываем сообщение "нет данных"
            if (emptyMsg) emptyMsg.remove();
            
            // Создаём или обновляем таблицу
            let tableContainer = document.querySelector('.overflow-x-auto');
            if (!tableContainer) {
                // Создаём таблицу заново
                const wrapper = document.createElement('div');
                wrapper.className = 'overflow-x-auto';
                const table = document.createElement('table');
                table.className = 'w-full';
                table.innerHTML = `
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">ID</th>
                            <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Имя</th>
                            <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Email</th>
                            <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Статус</th>
                            <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Дата</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200" id="users-table-body"></tbody>
                `;
                wrapper.appendChild(table);
                const section = document.querySelector('.mt-8.bg-white:last');
                const emptyMessage = document.getElementById('empty-message');
                if (emptyMessage) {
                    emptyMessage.replaceWith(wrapper);
                } else {
                    section.appendChild(wrapper);
                }
                tbody = document.getElementById('users-table-body');
            }
            
            // Рендерим строки
            tbody.innerHTML = data.users.map(user => `
                <tr class="hover:bg-gray-50">
                    <td class="px-4 py-3 text-sm">${user.id}</td>
                    <td class="px-4 py-3 text-sm font-medium">${escapeHtml(user.name)}</td>
                    <td class="px-4 py-3 text-sm text-blue-600">${escapeHtml(user.email)}</td>
                    <td class="px-4 py-3">
                        <span class="px-2 py-1 text-xs rounded-full ${user.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800'}">
                            ${user.status}
                        </span>
                    </td>
                    <td class="px-4 py-3 text-sm text-gray-500">${user.created_at}</td>
                </tr>
            `).join('');
        }
    } catch (error) {
        console.error('Error refreshing data:', error);
    }
}

// Экранирование HTML
function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

// Обработка формы
document.getElementById('query-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const formData = new FormData(form);
    
    const resultDiv = document.getElementById('query-result');
    const resultContent = document.getElementById('result-content');
    
    resultDiv.classList.remove('hidden');
    resultContent.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Выполнение...';
    resultContent.className = 'p-4 rounded-lg bg-gray-100';
    
    try {
        const response = await fetch('/query_run?' + new URLSearchParams(formData));
        const result = await response.json();
        
        if (result.success) {
            resultContent.className = 'p-4 rounded-lg bg-green-100 text-green-800';
            if (result.message) {
                resultContent.innerHTML = '<i class="fas fa-check-circle mr-2"></i>' + result.message;
            } else if (result.users) {
                resultContent.innerHTML = '<i class="fas fa-check-circle mr-2"></i>Найдено: ' + result.users.length + ' записей';
            }
            if (result.id) {
                resultContent.innerHTML += ' (ID: ' + result.id + ')';
            }
            
            // Обновляем данные без перезагрузки страницы
            await refreshData();
            
            // Очищаем форму после успешного INSERT
            if (formData.get('type') === 'insert') {
                form.reset();
            }
            
            // Скрываем сообщение через 2 секунды
            setTimeout(() => {
                resultDiv.classList.add('hidden');
            }, 2000);
        } else {
            resultContent.className = 'p-4 rounded-lg bg-red-100 text-red-800';
            resultContent.innerHTML = '<i class="fas fa-exclamation-circle mr-2"></i>' + result.message;
        }
    } catch (error) {
        resultContent.className = 'p-4 rounded-lg bg-red-100 text-red-800';
        resultContent.innerHTML = '<i class="fas fa-exclamation-circle mr-2"></i>Ошибка: ' + error.message;
    }
});
</script>
{% endblock %}
