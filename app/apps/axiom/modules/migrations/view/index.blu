{% block title %}Миграции - Axiom ORM{% endblock %}

{% block content %}
<div class="container mx-auto px-4 py-8">
    <h1 class="text-3xl font-bold text-gray-800 mb-2">
        <i class="fas fa-exchange-alt text-green-600 mr-2"></i>Миграции
    </h1>
    <p class="text-gray-600 mb-8">Управление миграциями базы данных</p>
    
    <div class="grid lg:grid-cols-3 gap-8">
        <!-- Действия -->
        <div class="bg-white rounded-xl shadow-md p-6">
            <h2 class="text-xl font-bold text-gray-800 mb-4">
                <i class="fas fa-cogs text-purple-600 mr-2"></i>Действия
            </h2>
            
            <div class="space-y-3">
                <button id="btn-migrate" class="w-full bg-green-600 text-white py-3 px-4 rounded-lg hover:bg-green-700 transition flex items-center justify-center">
                    <i class="fas fa-play mr-2"></i>Запустить миграции
                </button>
                
                <button id="btn-rollback" class="w-full bg-orange-600 text-white py-3 px-4 rounded-lg hover:bg-orange-700 transition flex items-center justify-center">
                    <i class="fas fa-undo mr-2"></i>Откатить последнюю
                </button>
            </div>
            
            <div id="migration-result" class="mt-4 hidden">
                <div id="result-content" class="p-4 rounded-lg"></div>
            </div>
        </div>
        
        <!-- Статус миграций -->
        <div class="lg:col-span-2 bg-white rounded-xl shadow-md p-6">
            <h2 class="text-xl font-bold text-gray-800 mb-4">
                <i class="fas fa-list text-blue-600 mr-2"></i>Статус миграций
            </h2>
            
            {% if status is empty %}
            <div class="text-center py-8 text-gray-500">
                <i class="fas fa-folder-open text-4xl mb-4"></i>
                <p>Нет миграций в папке migrations/</p>
            </div>
            {% else %}
            <div class="overflow-x-auto">
                <table class="w-full">
                    <thead class="bg-gray-50">
                        <tr>
                            <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Миграция</th>
                            <th class="px-4 py-3 text-left text-sm font-medium text-gray-700">Статус</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-200">
                        {% for item in status %}
                        <tr class="hover:bg-gray-50">
                            <td class="px-4 py-3 text-sm font-mono">{{ item.filename }}</td>
                            <td class="px-4 py-3">
                                {% if item.ran %}
                                <span class="px-2 py-1 text-xs rounded-full bg-green-100 text-green-800">
                                    <i class="fas fa-check mr-1"></i>Выполнена
                                </span>
                                {% else %}
                                <span class="px-2 py-1 text-xs rounded-full bg-yellow-100 text-yellow-800">
                                    <i class="fas fa-clock mr-1"></i>Ожидает
                                </span>
                                {% endif %}
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>
    </div>
    
    <!-- Доступные миграции -->
    <div class="mt-8 bg-white rounded-xl shadow-md p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-4">
            <i class="fas fa-folder-plus text-indigo-600 mr-2"></i>Ожидающие миграции
        </h2>
        
        {% if pending is empty %}
        <div class="text-center py-8 text-green-500">
            <i class="fas fa-check-circle text-4xl mb-4"></i>
            <p>Все миграции выполнены!</p>
        </div>
        {% else %}
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
            {% for migration in pending %}
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                <i class="fas fa-clock text-yellow-600 mr-2"></i>
                <span class="font-mono text-sm">{{ migration.filename }}</span>
            </div>
            {% endfor %}
        </div>
        {% endif %}
    </div>
    
    <!-- Пример создания миграции -->
    <div class="mt-8 bg-gray-900 rounded-xl shadow-md p-6">
        <h2 class="text-xl font-bold text-white mb-4">
            <i class="fas fa-code text-green-400 mr-2"></i>Пример миграции
        </h2>
        <pre class="text-gray-300 text-sm font-mono overflow-x-auto"><code><span class="text-purple-400">&lt;?php</span>

<span class="text-purple-400">use</span> Axiom\Migration\Migration;
<span class="text-purple-400">use</span> Axiom\Migration\Blueprint;

<span class="text-yellow-400">class</span> <span class="text-green-400">CreateUsersTable</span> <span class="text-yellow-400">extends</span> Migration
{
    <span class="text-yellow-400">public function</span> <span class="text-blue-400">up</span>(): <span class="text-blue-400">void</span>
    {
        <span class="text-yellow-400">$this</span>-><span class="text-blue-400">create</span>(<span class="text-green-400">'users'</span>, <span class="text-yellow-400">function</span> (Blueprint <span class="text-blue-400">$table</span>) {
            <span class="text-blue-400">$table</span>-><span class="text-blue-400">id</span>();
            <span class="text-blue-400">$table</span>-><span class="text-blue-400">string</span>(<span class="text-green-400">'name'</span>);
            <span class="text-blue-400">$table</span>-><span class="text-blue-400">string</span>(<span class="text-green-400">'email'</span>)-><span class="text-blue-400">unique</span>();
            <span class="text-blue-400">$table</span>-><span class="text-blue-400">string</span>(<span class="text-green-400">'password'</span>);
            <span class="text-blue-400">$table</span>-><span class="text-blue-400">enum</span>(<span class="text-green-400">'status'</span>, [<span class="text-green-400">'active'</span>, <span class="text-green-400">'inactive'</span>])-><span class="text-blue-400">default</span>(<span class="text-green-400">'active'</span>);
            <span class="text-blue-400">$table</span>-><span class="text-blue-400">timestamps</span>();
        });
    }

    <span class="text-yellow-400">public function</span> <span class="text-blue-400">down</span>(): <span class="text-blue-400">void</span>
    {
        <span class="text-yellow-400">$this</span>-><span class="text-blue-400">drop</span>(<span class="text-green-400">'users'</span>);
    }
}</code></pre>
    </div>
</div>

<script>
document.getElementById('btn-migrate').addEventListener('click', async () => {
    const resultDiv = document.getElementById('migration-result');
    const resultContent = document.getElementById('result-content');
    
    resultDiv.classList.remove('hidden');
    resultContent.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Выполнение миграций...';
    resultContent.className = 'p-4 rounded-lg bg-gray-100';
    
    try {
        const response = await fetch('/migrations_run');
        const result = await response.json();
        
        if (result.success) {
            resultContent.className = 'p-4 rounded-lg bg-green-100 text-green-800';
            resultContent.innerHTML = '<i class="fas fa-check-circle mr-2"></i>' + result.message;
            setTimeout(() => location.reload(), 1500);
        } else {
            resultContent.className = 'p-4 rounded-lg bg-red-100 text-red-800';
            resultContent.innerHTML = '<i class="fas fa-exclamation-circle mr-2"></i>' + result.message;
        }
    } catch (error) {
        resultContent.className = 'p-4 rounded-lg bg-red-100 text-red-800';
        resultContent.innerHTML = '<i class="fas fa-exclamation-circle mr-2"></i>Ошибка: ' + error.message;
    }
});

document.getElementById('btn-rollback').addEventListener('click', async () => {
    if (!confirm('Откатить последнюю миграцию?')) return;
    
    const resultDiv = document.getElementById('migration-result');
    const resultContent = document.getElementById('result-content');
    
    resultDiv.classList.remove('hidden');
    resultContent.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i>Откат миграции...';
    resultContent.className = 'p-4 rounded-lg bg-gray-100';
    
    try {
        const response = await fetch('/migrations_rollback');
        const result = await response.json();
        
        if (result.success) {
            resultContent.className = 'p-4 rounded-lg bg-orange-100 text-orange-800';
            resultContent.innerHTML = '<i class="fas fa-undo mr-2"></i>' + result.message;
            setTimeout(() => location.reload(), 1500);
        } else {
            resultContent.className = 'p-4 rounded-lg bg-red-100 text-red-800';
            resultContent.innerHTML = '<i class="fas fa-exclamation-circle mr-2"></i>' + result.message;
        }
    } catch (error) {
        resultContent.className = 'p-4 rounded-lg bg-red-100 text-red-800';
        resultContent.innerHTML = '<i class="fas fa-exclamation-circle mr-2"></i>Ошибка: ' + error.message;
    }
});
</script>
{% endblock %}
